{
  "name": "purs-solid",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run test:client && npm run test:server",
    "test:client": "NODE_OPTIONS='--conditions=browser --conditions=development --import=./test/setup-dom.mjs' spago test",
    "test:server": "NODE_OPTIONS=--conditions=development spago test --main Test.Server.Main",
    "test:purescript": "npm test",
    "test:purescript:es": "purs-backend-es build && NODE_OPTIONS='--conditions=browser --conditions=development --import=./test/setup-dom.mjs' node --input-type=module -e \"import('./output-es/Test.Main/index.js').then((m) => m.main())\" && NODE_OPTIONS=--conditions=development node --input-type=module -e \"import('./output-es/Test.Server.Main/index.js').then((m) => m.main())\"",
    "test:browser-smoke": "spago build && node test/browser/run-smoke.mjs",
    "test:all": "npm test && npm run test:browser-smoke && npm run test:hydration && npm run test:start",
    "bench": "spago build && node test/bench/run-bench.mjs",
    "gen:dom": "node scripts/gen-dom.mjs",
    "test:hydration": "spago build && node test/hydration/run-hydration.mjs",
    "test:start": "spago build && node test/start/run-start-mode.mjs",
    "build:example:hackernews": "spago build && vite build --config src/Examples/HackerNews/Host/vite.config.mjs",
    "start:example:hackernews": "node src/Examples/HackerNews/Host/dist/server/node.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@solidjs/h": "2.0.0-rc.11",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.31",
    "@solidjs/web": "2.0.0-rc.11",
    "solid-js": "2.0.0-rc.11"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "purs-backend-es": "1.4.3",
    "vite": "8.3.1"
  },
  "type": "module"
}
