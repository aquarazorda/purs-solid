{
  "name": "purs-solid",
  "version": "0.0.0",
  "private": true,
  "description": "PureScript bindings for Solid 2.0",
  "type": "module",
  "exports": {
    "./vite": "./vite/index.mjs"
  },
  "scripts": {
    "test": "npm run test:client && npm run test:server",
    "test:client": "NODE_OPTIONS='--conditions=browser --conditions=development --import=./test/setup-dom.mjs' spago test -p purs-solid",
    "test:server": "NODE_OPTIONS=--conditions=development spago test -p purs-solid --main Test.Server.Main",
    "test:purescript:es": "purs-backend-es build && NODE_OPTIONS='--conditions=browser --conditions=development --import=./test/setup-dom.mjs' node --input-type=module -e \"import('./output-es/Test.Main/index.js').then((m) => m.main())\" && NODE_OPTIONS=--conditions=development node --input-type=module -e \"import('./output-es/Test.Server.Main/index.js').then((m) => m.main())\"",
    "test:browser-smoke": "spago build && node test/browser/run-smoke.mjs",
    "test:hydration": "spago build && node test/hydration/run-hydration.mjs",
    "test:start": "spago build && node test/start/run-start-mode.mjs",
    "test:dev": "spago build && node test/dev/run-dev.mjs",
    "test:vite": "node test/vite/run-plugin.mjs",
    "test:types": "spago build && node test/types/run-types.mjs",
    "test:all": "npm test && npm run test:browser-smoke && npm run test:hydration && npm run test:start && npm run test:dev && npm run test:vite && npm run test:types",
    "bench": "spago build && node test/bench/run-bench.mjs",
    "bench:reference": "node test/bench/run-bench.mjs --reference",
    "gen:dom": "node scripts/gen-dom.mjs",
    "format": "purs-tidy format-in-place \"src/**/*.purs\" \"test/**/*.purs\" \"examples/src/**/*.purs\"",
    "format:check": "purs-tidy check \"src/**/*.purs\" \"test/**/*.purs\" \"examples/src/**/*.purs\"",
    "build:example:hackernews": "spago build && vite build --config examples/src/HackerNews/Host/vite.config.mjs",
    "start:example:hackernews": "node examples/src/HackerNews/Host/dist/server/node.js"
  },
  "license": "ISC",
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.32",
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "purescript": "0.15.15",
    "purs-backend-es": "1.4.3",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4",
    "vite": "8.3.1"
  },
  "peerDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "vite": "8.3.1"
  },
  "peerDependenciesMeta": {
    "@solidjs/vite-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
